{
  "$schema": "https://githubusercontent.com",
  "name": "C+",
  "scopeName": "source.csp",
  "patterns": [
    {
      "name": "keyword.control.csp",
      "match": "\\b(if|else|while|for|return|break|continue|goto|switch|case|default|__global__)\\b"
    },
    {
      "name": "storage.type.csp",
      "match": "\\b(int|float|double|char|void|bool|u8|u16|u32|u64|u128|unichar|let|mut)\\b"
    },
    {
      "name": "support.function.builtin.csp",
      "match": "\\b(printc|cp::print|cp::println)\\b"
    },
    {
      "name": "string.quoted.double.csp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.csp",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "comment.line.double-slash.csp",
      "match": "//.*$"
    }
  ]
}
